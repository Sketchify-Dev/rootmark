{
  "name": "portaldot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "indexer": "tsx indexer/index.ts",
    "wallet": "tsx scripts/wallet.mjs",
    "compile:evm": "node scripts/compile-evm.mjs",
    "deploy:evm": "tsx scripts/deploy-evm.mjs",
    "deploy:wasm": "tsx scripts/deploy-wasm.mjs",
    "verify:proof": "tsx scripts/verify-proof.mjs",
    "build:wasm": "cargo contract build --release --manifest-path contracts/wasm/anchor/Cargo.toml",
    "setup": "node scripts/setup.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "ethers": "^6.17.0",
    "js-sha3": "^0.13.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "solc": "^0.8.37",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
