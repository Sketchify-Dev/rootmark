{
  "name": "rootmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "indexer": "tsx indexer/index.ts",
    "wallet": "tsx scripts/wallet.mjs",
    "compile:evm": "node scripts/compile-evm.mjs",
    "deploy:evm": "tsx scripts/deploy-evm.mjs",
    "deploy:wasm": "tsx scripts/deploy-wasm.mjs",
    "verify:proof": "tsx scripts/verify-proof.mjs",
    "build:wasm": "cargo contract build --release --manifest-path contracts/wasm/anchor/Cargo.toml",
    "setup": "node scripts/setup.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "ethers": "^6.17.0",
    "js-sha3": "^0.13.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "ganache": "^7.9.2",
    "playwright": "^1.64.1",
    "solc": "^0.8.37",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Verifiable data and query middleware for the Portaldot V3 chain. One query across EVM and ink! events, every result carries a Merkle proof.",
  "keywords": [
    "portaldot",
    "polkadot",
    "evm",
    "ink",
    "merkle",
    "middleware",
    "verifiable",
    "substrate"
  ],
  "author": "Rootmark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sketchify-Dev/rootmark.git"
  },
  "homepage": "https://github.com/Sketchify-Dev/rootmark#readme",
  "bugs": {
    "url": "https://github.com/Sketchify-Dev/rootmark/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
